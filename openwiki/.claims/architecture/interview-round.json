    },
    {
      "id": "claim_bda97269b5244e928edf1669c2bd91b1",
      "statement": "One QuestionProduction serves every waiting caller, making the model reachable once per session rather than once per request; the interview owns an AbortController per production and hands the model that signal, never a caller's, and the production is cancelled only once every caller sharing it has left — the moment the last caller's signal aborts, not at the model's next chunk.",
      "evidence": [
        {
          "resource": "repo://packages/core/src/interview/single-turn-interview.ts#L200-L230",
          "version": "repo-lines-v1:sha256:2c392a03eb2d935bd58b1cecd2fb6dc3d5a45541cefe1fc30de9bb78ae77a0ae:"

    },
    {
      "id": "claim_7c91ababe27c4ed3aca1b6eaf681cb73",
      "statement": "openingQuestion resolving loads the session (through loadInterview, which also resolves its language) and decides existence, so a caller can refuse with 404 before opening a stream and nothing is inferred; the generator's first pull is what reaches the model, while a session already holding a turn replays the stored question via replayStoredQuestion and reaches no model, leaving askedAt untouched.",
      "evidence": [
        {
          "resource": "repo://packages/core/src/interview/single-turn-interview.ts#L226-L241",
          "version": "repo-lines-v1:sha256:2f51a00870d1ec694d754eb07f4318093289d136077247fceda751b03b63f95d:"

  "claims": [
    {
      "id": "claim_329dcc7f952e42a89207fed41ae03721",
      "statement": "The filesystem session store is the only place in the workspace that knows a session is a folder on disk: it writes <root>/<id>/session.json and <root>/<id>/transcript.md, and @chrysalyst/core imports nothing from it.",
      "evidence": [
        {
          "resource": "repo://packages/server/src/adapters/session-store/filesystem-session-store.ts#L54-L145",
          "version": "repo-lines-v1:sha256:35cd1c79aea3ac1b8b2c3e39ff895e1072b639aa23b86dda0acd2df52354e8f1:"
        },
        {
          "resource": "repo://specs/adapters/filesystem-session-store/spec.md#L7-L9",
          "version": "repo-lines-v1:sha256:7667b8b0e6156a442cd5ff385dc868a487e6e9bcda20dacd7f2fadd2edb186b0:"
        }
      ]
    },
    {
      "id": "claim_a789bf2938244f07b856491f98393d1d",
      "statement": "session.json is an envelope { schemaVersion, id, createdAt, updatedAt, state } whose schemaVersion is the integer module constant 1 and versions the on-disk envelope, not the domain session; StoredSession in @chrysalyst/core gains no such field and the store passes state through by one documented `as` assertion.",
      "evidence": [
        {
          "resource": "repo://packages/server/src/adapters/session-store/filesystem-session-store.ts#L14-L35",
          "version": "repo-lines-v1:sha256:d596b91cc507baa33d2e4f0bf45d315e9f3e0b6aea2372e9f05176bb3a06ebb3:"
        },
        {
          "resource": "repo://packages/server/src/adapters/session-store/filesystem-session-store.ts#L321-L342",
          "version": "repo-lines-v1:sha256:3d527b81a5cbcb3a82e438631f5bfa24ad4aef0e63126afd39c42d3308e6cd44:"
        },
        {
          "resource": "repo://specs/_decision/003-add-filesystem-session-store.md#L30-L55",
          "version": "repo-lines-v1:sha256:cf2dfb14c32611bbb3fac547cf78088002c3b15c728702e5d77cffd89f13f207:"
        }
      ]
    },
    {
      "id": "claim_b77f00b4444e46d8bb28527112bc359a",
      "statement": "Because the store never interprets TState, a value inside the domain state must survive a JSON round trip: a nested Date returns as a string, and only the two envelope timestamps are revived to Date.",
      "evidence": [
        {
          "resource": "repo://packages/server/src/adapters/session-store/filesystem-session-store.ts#L331-L342",
          "version": "repo-lines-v1:sha256:e5d09bf89ce9f1a4c022f27c31250f887ec268bff480b3f3300e875a596d1f77:"
        },
        {
          "resource": "repo://specs/adapters/filesystem-session-store/spec.md#L45-L54",
          "version": "repo-lines-v1:sha256:2ba0f3527c5b3c10e46f66e818ad372de74b29f696ae67ecd80b628ac47c305e:"
        }
      ]
    },
    {
      "id": "claim_5d17101388d14ecbbafa5c5b19eacf6b",
      "statement": "transcript.md carries the interview but the store does not compose it: its config takes an optional renderTranscript (a pure function from the stored session to Markdown, taking the same StoredSession<TState> save receives), calls it when configured, and otherwise writes the metadata header it wrote before; the transcript is unversioned and a second save of the same identifier rewrites it.",
      "evidence": [
        {
          "resource": "repo://packages/server/src/adapters/session-store/filesystem-session-store.ts#L133-L143",
          "version": "repo-lines-v1:sha256:3ec89fcbaa3010e7cd37b3f63ba0286137a254c7c45fb17a3b89556096bf37b1:"
        },
        {
          "resource": "repo://packages/server/src/adapters/session-store/filesystem-session-store.ts#L37-L52",
          "version": "repo-lines-v1:sha256:e88a4332f46681f06c214d4419ca0f13a720acb23158d3ad31e88a5ab9e48fc5:"
        },
        {
          "resource": "repo://specs/adapters/filesystem-session-store/spec.md#L13-L15",

    {
      "id": "claim_09b28a45619141d98d4b8e4fa1bd5c28",
      "statement": "The asked turn is saved only after the model stream ends of its own accord and yields non-blank text, and a caller's iteration ends only after that save resolves — so a caller that reached the end is looking at a question already on disk, and an abandoned, rejected, or blank production leaves nothing behind.",
      "evidence": [
        {
          "resource": "repo://packages/core/src/interview/single-turn-interview.ts#L145-L185",
          "version": "repo-lines-v1:sha256:9d65195c99c78db6093804cd227ec3eb2013e98a0927631bc268322a63dc85be:"
        }

    {
      "id": "claim_8e4956c21ef543b5b959e56fc575fd75",
      "statement": "app.ts exports a factory createApp(deps: CoreDependencies<InterviewState>) rather than a module-scope instance, chains every route onto one expression, and derives AppType = ReturnType<typeof createApp> so a route cannot be missing from the client type and a test can build the app over fakes.",
      "evidence": [
        {
          "resource": "repo://packages/server/src/app.ts",
          "version": "repo-file-v1:sha256:81e500359cd63e34ac40f513bd49c07067043d6302f9451be8ef80e34ef01707"

    {
      "id": "claim_41669f043f5645ddb9e3bd8ff02cfa5f",
      "statement": "createSingleTurnInterview binds CoreDependencies once and returns three operations — begin(id, locale) (leaves an existing session's turns and language untouched), openingQuestion (yields the question's chunks or resolves undefined for a never-begun id), recordAnswer (answers recorded/no-session/no-open-question) — and no status code appears in the domain.",
      "evidence": [
        {
          "resource": "repo://packages/core/src/interview/single-turn-interview.ts#L22-L59",
          "version": "repo-lines-v1:sha256:ec9d26672032eada18802643eb977848467b91e9f93e8553f524226839de065f:"

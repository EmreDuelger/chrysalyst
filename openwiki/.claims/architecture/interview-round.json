    {
      "id": "claim_06a0904d04324924b5ab23d2b3ddd3f3",
      "statement": "InterviewState v1 is `{ locale: Locale; turns: readonly Turn[] }` — a list from the start because M8 grows the interview to many turns and a pair would force a schema break on the second, with the language added in M5 as a property of the state itself, chosen once at session creation and never changed — and Turn is a union tagged by `status` rather than by the presence of `answer`, because the tag is the only form TypeScript narrows on after a JSON round trip.",
      "evidence": [
        {
          "resource": "repo://packages/core/src/interview/state.ts",
          "version": "repo-file-v1:sha256:ceed5b2084c83ed906229fdb580049083d3d991fe4afc2c7680cecd4a97f9076"

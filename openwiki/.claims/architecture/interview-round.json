    {
      "id": "claim_09b28a45619141d98d4b8e4fa1bd5c28",
      "statement": "The asked turn is saved only after the model stream ends of its own accord and yields non-blank text, and a caller's iteration ends only after that save resolves — so a caller that reached the end is looking at a question already on disk, and an abandoned, rejected, or blank production leaves nothing behind.",
      "evidence": [
        {
          "resource": "repo://packages/core/src/interview/single-turn-interview.ts#L139-L180",
          "version": "repo-lines-v1:sha256:7d5ab6c3c997b0fb17c5224160ac79176dea2a63fb6a7b8f63f5de900bfbe6a6:"
        }
      ]
    },
    {
      "id": "claim_bda97269b5244e928edf1669c2bd91b1",
      "statement": "One QuestionProduction serves every waiting caller, making the model reachable once per session rather than once per request; the interview owns an AbortController per production and hands the model that signal, never a caller's, and the production is cancelled only once every caller sharing it has left — the moment the last caller's signal aborts, not at the model's next chunk.",
      "evidence": [
        {
          "resource": "repo://packages/core/src/interview/single-turn-interview.ts#L197-L224",
          "version": "repo-lines-v1:sha256:e8c0a955b21115ad3d4573f8fddfefe32245ceee6403ef1988e0382a6e9efddf:"
        },
        {

    {
      "id": "claim_e7673e94e88d47b6a5c8a0a50d86fe5f",
      "statement": "parseSseFrames reassembles arbitrarily split stream text structurally: it splits accumulated text on the \\n\\n frame separator, holds the final part back for the next chunk, and skips any block missing an event or data field — so a frame is yielded only once its terminating blank line arrives, a trailing partial frame is dropped, and one odd block cannot tear down a live stream.",
      "evidence": [
        {
          "resource": "repo://packages/web/src/interview/sse-frames.ts",
          "version": "repo-file-v1:sha256:44617ca227191b2c9ef15e988bf16f4f64de1536dcf8e736ea3eee4e67bb98d5"
        }
      ]
    },
    {
      "id": "claim_607ef9729ad9421d860e84a3af867efc",
      "statement": "The parser keeps data byte-for-byte and never throws; decoding it into one of the three payload shapes and rejecting an unknown event name or a malformed data payload is interview-api.ts's job, and the parser is checked at every byte boundary of tests/fixtures/interview-sse-frames.txt against pure string identity.",
      "evidence": [

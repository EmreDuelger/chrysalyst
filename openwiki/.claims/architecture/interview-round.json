    {
      "id": "claim_5bdd108631054ac486c78b3e156ba137",
      "statement": "The interview is deliberately one round only — M7 owns the question tree, M8 the turn loop, M10 distillation — and the opening question is produced cold with no idea input, from one of two independently authored per-language templates in openingPrompts, selected by the session's own locale.",
      "evidence": [
        {
          "resource": "repo://packages/core/src/interview/prompts.ts",
          "version": "repo-file-v1:sha256:558dd994e54b6de82e0805458cebfefa0d5e71f70199bbb52b18c2b0322fdf7a"

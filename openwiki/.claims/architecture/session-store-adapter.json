          "version": "repo-lines-v1:sha256:090f9c9d428afb0173d55618b8b538f17fed804fd7551a9a505e2e6dc5fb20ce:"
        }
      ]
    },
    {
      "id": "claim_f50382eeb40c4ca1bcb7bf5e699ac973",
      "statement": "sessionStoreConfigFromEnv is a pure function of a passed environment record that resolves CHRYSALYST_SESSION_DIR to an absolute path and defaults to join(homedir(), '.chrysalyst', 'sessions'), touching no file so no dotenv loader enters the dependency set; it mirrors llmConfigFromEnv.",

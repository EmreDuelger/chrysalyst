    {
      "id": "claim_248dc73786274696a0d66c2dd42252d8",
      "statement": "InterviewView is a six-phase state machine (connecting, streaming, complete, submitting, recorded, failed): a mount-time useEffect creates a session in the language frozen at mount (a ref) then opens the question stream and appends chunks; an AbortController in cleanup aborts on unmount; a failure shows in place and the answer control never opens; every label renders from the live `locale` prop via `uiStrings`.",
      "evidence": [
        {
          "resource": "repo://packages/web/src/interview/InterviewView.tsx#L23-L34",
          "version": "repo-lines-v1:sha256:49441b8a021e9f014626022fb6e4265899afa80f087d2858455abb54db1774f9:"
